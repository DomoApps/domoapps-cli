{
  "compilerOptions": {
    "outDir": "dist",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es5",
    "lib": ["es6", "es2017", "dom"],
    "jsx": "react",
    "allowJs": true,
    "types": ["jest"],
    "suppressImplicitAnyIndexErrors": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["node_modules", "dist", "distcopy", "**/*.spec.ts", "templates"]
}
