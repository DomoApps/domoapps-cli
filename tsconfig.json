{
  "compilerOptions": {
    "outDir": "dist",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "jsx": "react",
    "allowJs": true,
    "types": ["jest"],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "skipLibCheck": true,
    "strict": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "distcopy",
    "**/*.spec.ts",
    "**/*.test.ts",
    "tests",
    "templates",
    "*.js",
    "bin/domo-binary.js"
  ]
}
