{
    "compilerOptions": {
      "outDir": "dist",
      "sourceMap": true,
      "noImplicitAny": false,
      "module": "commonjs",
      "target": "es5",
      "lib": ["es6", "es2017", "dom"],
      "jsx": "react",
      "allowJs": true,
      "suppressImplicitAnyIndexErrors": true
    },
    "include": ["**/*"],
    "exclude": [
      "node_modules",
      "dist",
      "**/*.spec.ts",
      "templates"
    ]
  }