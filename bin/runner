#!/usr/bin/env node --harmony

var os = require('os'),
    path = require('path');

process.env.BABEL_CACHE_PATH = path.join(os.tmpdir(), '/ryuu.json');

// enable awesomeness
require("babel/register")({
  stage: 0,
  sourceMap: 'inline',
  only: ['domo.js', 'server.js']
});

// enable source maps
require('source-map-support').install();

require('./domo');

