#!/usr/bin/env node --harmony

var os = require('os'),
    path = require('path');

process.env.BABEL_CACHE_PATH = path.join(os.tmpdir(), '/ryuu.json');

// enable awesomeness
require("babel/register")({
  stage: 0,
  sourceMap: 'inline',
  only: ['domo.js', 'server.js', 'commands/**.js']
});

process.on('uncaughtException', function (err) {
    console.error('[ERROR] The domo cli tool as experienced an unhandled error. As it is');
    console.error('[ERROR] possible this bug has already been fixed, please update using');
    console.error('[ERROR] `npm install -g ryuu` and running this command again. If this');
    console.error('[ERROR] does not fix the issues, please contact your MajorDomo');
    console.error('[ERROR] error message: %s', err.message);
});

// enable source maps
require('source-map-support').install();

require('./domo');
