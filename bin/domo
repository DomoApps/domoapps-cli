program
  .version('1.3.0')
  .option('-w, --watch', 'publish domoapp design every time a file changes')
  .option('-v, --verbose', 'log more details including XHR responses, useful for troubleshooting')

program
  .command('publish')
  .description('publish a new or existing domoapp design')
  .action(function(){
    try{
      var manifest = require(path.resolve('manifest.json'));
    }
    catch (e){
      fail('Cannot publish from this directory', {message: 'Please navigate to a directory containing a domoapp design manifest.json file'});
      return;
    }
    var login = getMostRecentLogin();

    if (!login){
      fail('Not authenticated', {message: 'Please login using "domo login"'});
      return;
    }
    var domo = new Domo(login.customer, login.sid);

    if (!manifest.id){
      domo.createDesign(manifest)
          .then(function(design){
            return persistDesignId(design, manifest)
          })
          .tap(evoke(ok, 'New design created'))
          .catch(evoke(fail, 'Error creating new design'))
          .then(domo.uploadAllAssets.bind(domo))
          .then(logUploadSuccess)
          .catch(evoke(fail, 'Error uploading assets'))
    }
    else{
      domo.uploadAllAssets(manifest)
        .then(logUploadSuccess)
        .catch(evoke(fail, 'Error uploading assets'))
    }

    if (program.watch){ watch(domo, login, manifest); }
  });

program
  .command('init')
  .description('initialize a new domoapp design')
  .action(function(){
    inquirer.prompt([{
        type: 'input',
        message: 'design name',
        name: 'name'
      }], function(answers){
        answers.datasources = [];
        askDatasource(answers, function(allAnswers){
          // populate and write out the template files
          var files = ['manifest.json', 'index.html', 'domo.js', 'app.js', 'app.css'];
          files.forEach(function(file){
            var contents = _.template(fs.readFileSync(path.resolve(__dirname + '/../templates/' + file )))(allAnswers);
            fs.writeFileSync(process.cwd() + '/' + file, contents);
          });
          
          ok('New design initialized. Run domo publish when you\'re ready.');
        });
      });
  });
  
function addDatasource(currentAnswers, callback){
    inquirer.prompt([
      {
        type: 'input',
        message: 'datasource id',
        name: 'id'
      },
      {
        type: 'input',
        message: 'datasource alias',
        name: 'alias'
      }
    ], function(datasource){
      currentAnswers.datasources.push(datasource);
      callback(currentAnswers);
    });
}

// recursively ask user to enter all their datasources
function askDatasource(currentAnswers, callback){
  inquirer.prompt([
    {
      type: 'confirm',
      message: currentAnswers.datasources.length > 0 ? 'add another datasource?' : 'would you like to connect to any datasources?',
      name: 'askDatasource'
    }
  ], function(answers){
    if (answers.askDatasource){
      addDatasource(_.merge(currentAnswers, answers), function(combinedAnswers){
        // ask for more datasources
        askDatasource(combinedAnswers, callback);
      });
    }
    else {
      // all done with datasources, continue on.
      callback(_.merge(currentAnswers, answers));
    }
  })
}


program
  .command('login')
  .description('login to domo')
  .action(function(){
    // get default values from previous logins
    var mostRecent = getMostRecentLogin() || {};

    // prompt user
    inquirer.prompt([
      {
        type: "input",
        message: "domo customer",
        name: "customer",
        default: mostRecent.customer
      },
      {
        type: "input",
        message: "user email",
        name: "email",
        default: mostRecent.user
      },
      {
        type: "password",
        message: "domo password",
        name: "password"
      }
    ], function(answers) {
      var domo = new Domo(answers.customer, null);
      domo
        .login(answers.email, answers.password)
        .then(function(login){
          ok('Login successful. Welcome, ' + login.user.USER_FULLNAME + '.');
          console.log(chalk.cyan(logo));
          return login;
        })
        .then(persistLogin(answers.customer, answers.email))
    });
  });

program
  .command('migrate')
  .description('migrate a mason app to a domoapp')
  .action(function(){
    var manifest = require(path.resolve('manifest.json'));
    var mostRecent = getMostRecentLogin() || {};

    inquirer.prompt([
      {
        type: "input",
        message: "domo customer",
        name: "customer",
        default: mostRecent.customer
      },
      {
        type: "input",
        message: "app id",
        name: "id"
      }
    ], function(answers) {
      var login = getLogin(answers.customer);
      if (!login){
        fail('Please login to ' + answers.customer + ' first using "domo login"');
        return;
      }
      
      var domo = new Domo(answers.customer, login.sid);

      migrateApp(domo, answers.id, manifest)
        .tap(evoke(ok, 'Migration successful'))
        .catch(evoke(fail, 'Migration unsuccessful'))
    });
  });

program
  .command('revert')
  .description('revert a migration, turning a domoapp back into a mason app')
  .action(function(){
    var mostRecent = getMostRecentLogin() || {};
    
    inquirer.prompt([
      {
        type: "input",
        message: "domo customer",
        name: "customer",
        default: mostRecent.customer
      },
      {
        type: "input",
        message: "app id",
        name: "id"
      }
    ], function(answers) {
      var login = getLogin(answers.customer);
      if (!login){
        fail('Please login to ' + answers.customer + ' first using "domo login"');
        return;
      }
      
      var domo = new Domo(answers.customer, login.sid);
      domo.getKpi(answers.id)
          .then(function(kpi){
            kpi.type = kpi.metadata.chartType = kpi.metadata.kpiType = 'mason';
            return kpi;
          })
          .then(function(kpi){
            return domo.updateKpi(kpi);
          })
          .tap(evoke(ok, 'Card reverted back to a mason app'))
          .catch(evoke(fail, 'Error attempting to revert card'))
    });

  })

program.parse(process.argv);

/**
 * migrate a mason app to a domoapp
 * 1. get the kpi info
 * 2. create a new domoapp design
 * 3. publish design assets
 * 4. create a new domoapp
 * 5. update the kpi
 */
function migrateApp(domo, appId, manifest){
  return Promise.all([
    domo.getKpi(appId),

        // .catch(evoke(fail, 'No app found with id ' + appId)),
    // publish new design (and persist id) if not already published
    domo.createDesign(manifest)
      .tap(evoke(ok, 'Design published'))
      .then(function(design){
        return persistDesignId(design, manifest)
      })
      .catch(function(){
        return manifest;
      })
  ])
  .spread(function(kpi, design){
    return domo
        .createApp(design.id)
        .tap(evoke(ok, 'New domoapp created'))
        .catch(evoke(fail, 'Error creating new domoapp'))
        .then(function(domoapp){
          kpi.type = kpi.metadata.chartType = kpi.metadata.kpiType = 'domoapp';
          kpi.domoapp.id = domoapp.id;

          return domo.updateKpi(kpi)
              .tap(evoke(ok, 'Card type updated and linked'))
              .catch(evoke(fail, 'Error updating card'))
              .then(function(){
                return domo.uploadAllAssets(manifest);
              })
              .tap(evoke(ok, 'Assets uploaded'))
              .catch(evoke(fail, 'Error uploading assets'))
        })
  })

};

function watch(domo, login, manifest){

  gaze('**/*', function(err, watcher) {
    this.on('all', function(event, filepath) {
      // TODO: handle deleting of assets

      var relFilePath = path.relative(process.cwd(), filepath);
      domo.uploadAsset(manifest.id, manifest.version, relFilePath)
          .tap(evoke(ok, 'Uploaded: ' + relFilePath))
          .catch(evoke(fail, 'Error uploading: ' + relFilePath))
    });
  });
}

function logUploadSuccess(files){
  files.forEach(function(file){
    ok('Uploaded: ' + file.path);
  });
}

/**
 * curry a function
 */
function evoke(fn, arg){
  return function(result){
    fn(arg, result);
  }
}

/**
 * log a success
 */
function ok(msg){
  console.log(chalk.green('\u2713'), msg);
}

/**
 * log an error
 */
function fail(msg, result){
  console.log(chalk.red('X'), msg);
  if(result && result.message){
    console.log(chalk.gray(result.message));
  }

  if (program.verbose){
    console.log(chalk.red("statusCode:"), result.statusCode);
    if(result.details){
      console.log(chalk.red("details:"), result.details); 
    }
    console.log(chalk.red("method:"), result.method); 
    console.log(chalk.red("path:"), result.path); 
    console.log(chalk.red("response:"), result.res);
  }
}

function getMostRecentLogin(){
  var logins = glob.sync(home + "/login/*.json");
  if (logins.length == 0) return;

  var mostRecent = logins.reduce(function(prev, next){
    return fs.statSync(prev).mtime > fs.statSync(next).mtime ? prev : next;
  });
  return fs.readJsonSync(mostRecent);
}

/**
 * persist login to user's domo home
 */
function persistLogin(customer, email){
  return function(login){
    var loginFile = path.resolve(home + '/login/' + customer + '.json');
    fs.ensureFileSync(loginFile);
    fs.writeJsonSync(loginFile, { sid: login.sid, user: email, customer: customer });
    return login;
  }
}

/**
 * update the manifest (in memory and on disk)
 */
function persistDesignId(design, manifest){
  manifest.id = design.id;
  fs.writeJsonSync('manifest.json', manifest);
  return design;
}

function getLogin(customer){
  return fs.readJsonSync(path.resolve(home + '/login/' + customer + '.json'), {throws: false});
}