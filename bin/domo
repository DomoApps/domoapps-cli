#!/usr/bin/env node
/**
 * this executable will take care of capturing user input,
 * passing data on to the domo lib
 */

var domo = require('../lib/domo');
var program = require('commander');
var gaze = require('gaze');
var path = require('path');
var inquirer = require("inquirer");
var chalk = require('chalk');
var fs = require('fs-extra');
var glob = require("glob");
var home = domo.getUserHome();

program
  .version('0.0.1')
  .option('-w, --watch', 'publish domoapp design every time a file changes')

program
  .command('publish')
  .description('publish a new or existing domoapp design')
  .action(function(){
    var manifest = require(path.resolve('manifest.json'));
    var login = getLogin(manifest.customer);
    if (!login){
      console.log(chalk.red('X'), 'Please login using "domo login"');
      return;
    }
    if (program.watch){ watch(login); }
    domo.publish(login.customer, login.sid, null);
  });

program
  .command('login')
  .description('login to domo')
  .action(function(){
    // get default values from previous logins
    var logins = glob.sync(home + "/login/*.json");
    var mostRecent = {};

    if (logins.length > 0){
      mostRecent = logins.reduce(function(prev, next){
        return fs.statSync(prev).mtime > fs.statSync(next).mtime ? prev : next;
      });
      mostRecent = fs.readJsonSync(mostRecent);
    }


    // prompt user
    inquirer.prompt([
      {
        type: "input",
        message: "domo customer",
        name: "customer",
        default: mostRecent.customer
      },
      {
        type: "input",
        message: "user email",
        name: "email",
        default: mostRecent.user
      },
      {
        type: "password",
        message: "domo password",
        name: "password"
      }
    ], function(answers) {
      domo.login(answers.customer, answers.email, answers.password);
    });
  });

program.parse(process.argv);

function watch(login){

  gaze('**/*', function(err, watcher) {
    this.on('all', function(event, filepath) {
      // TODO: handle deleting of assets

      var relFilePath = path.relative(process.cwd(), filepath);
      domo.publish(login.customer, login.sid, relFilePath);
    });
  });
}

function getLogin(customer){
  return fs.readJsonSync(path.resolve(home + '/login/' + customer + '.json'), {throws: false});
}