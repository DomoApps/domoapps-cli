# Domo Apps CLI Integration Test Configuration
# Copy this file to integration-test.env and customize with your credentials

# Primary Domo instance for testing (REQUIRED)
DOMO_INSTANCE_1=your-instance.domo.com
DOMO_USERNAME_1=your-email@company.com
DOMO_PASSWORD_1=your-password
DOMO_TOKEN_1=your-dev-token
TEST_APP_NAME_1=test-app-integration

# Secondary instance (optional - for multi-instance tests)
# DOMO_INSTANCE_2=company2.domo.com
# DOMO_USERNAME_2=testuser2@company.com
# DOMO_PASSWORD_2=your-password-here
# DOMO_TOKEN_2=your-dev-token-here

# Optional test data
# TEST_DATASET_ID_1=dataset-id-1
# TEST_DATASET_ID_2=dataset-id-2
