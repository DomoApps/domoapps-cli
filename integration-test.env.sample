# Domo Apps CLI Integration Test Configuration
# Copy this file to integration-test.env and customize with your credentials

# Primary Domo instance for testing (REQUIRED)
PRIMARY_INSTANCE=your-instance.domo.com
PRIMARY_USERNAME=your-email@company.com
PRIMARY_PASSWORD=your-password
PRIMARY_TOKEN=your-dev-token

# Secondary instance (optional - for multi-instance tests)
# SECONDARY_INSTANCE=company2.domo.com
# SECONDARY_USERNAME=testuser2@company.com
# SECONDARY_PASSWORD=your-password-here
# SECONDARY_TOKEN=your-dev-token-here
