#!/usr/bin/env node

import {fileURLToPath} from 'url';
import path from 'path';
import 'source-map-support/register.js';

let already_warned = false;

function on_unhandled_error(err) {
  if (already_warned) {
    return;
  }

  already_warned = true;

  console.log('');
  console.error('[ERROR] The domo cli tool has experienced an error.');
  console.error(
    '[ERROR] As it is possible this bug has already been fixed, please try updating',
  );
  console.error('[ERROR] this tool using `npm install -g ryuu`');
  console.error(
    '[ERROR] If this does not fix the issue, please contact your MajorDomo.',
  );
  console.error('[ERROR] error message: %s', err.message);

  process.exit(1);
}

process.on('unhandledRejection', on_unhandled_error);
process.on('uncaughtException', on_unhandled_error);

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

await import(path.join(__dirname, 'domo.js'));
