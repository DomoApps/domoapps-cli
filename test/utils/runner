#!/bin/bash

COLOR_OK='\033[0;32m'
COLOR_TEST_GROUP=$(tput bold)
COLOR_RESET='\033[0m'

function domo() {
    $DOMO_CLI $@
}

function domo:runner:validate() {
    local last_status=$?

    if [ $last_status -ne 0 ]; then
        domo:log:error "detected an exit code of $last_status."
        fail
    fi
}

function fail() {
    domo:log:error "error"
    exit 1
}

function ok() {
    echo -e "${COLOR_OK}ok${COLOR_RESET}"
}

function validate() {
    domo:runner:validate
}

function test_group() {
    echo
    echo -e "## ${COLOR_TEST_GROUP}$@${COLOR_RESET}"
    echo
}

function it() {
    echo -n " - $@: "
}

function msg() {
    echo "    - $@"
}

function flip_status() {
    [ $? -eq 0 ] && false || true
}

function not_contains() {
    internal_contains "$1" "$2"

    flip_status
    validate
}

function contains() {
    internal_contains "$1" "$2"

    validate
}

function internal_contains() {
    local substr="$1"
    local fullstr="$2"

    echo "$fullstr" | grep "$substr" &> /dev/null
}

function json_extract() {
    local prop="$1"
    local json="$2"

    echo "$json" | grep -w "$prop" | awk '{print $2}' | sed -E 's/^"|"$|",$//g'
}
