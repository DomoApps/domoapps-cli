#!/bin/bash

# param 1 - comment
function domo:log:comment() {
    echo
    echo "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    echo "  $1"
    echo "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    echo
}

# param 1 - error
function domo:log:error() {
    echo
    echo "::ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR::"
    echo "::ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR::"
    echo "  ERROR: $1"
    echo "::ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR::"
    echo "::ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR:ERROR::"
    echo
}
