#!/bin/bash

design_name="autogenerated-$(date +%s)-$RANDOM"
design_version="1.0.0"

manifest_json=$(domo:fs:tmp:file manifest.json)
index_html=$(domo:fs:tmp:file index.html)
styles_css=$(domo:fs:tmp:file styles.css)

cat > $manifest_json <<- DELIM
{
  "name": "$design_name",
  "version": "$design_version",
  "size": {
    "width": 1,
    "height": 1
  },
  "mapping": []
}
DELIM

cat > $index_html <<- DELIM
<html>
  <head>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <h1>$design_name</h1>
  </body>
</html>
DELIM

cat > $styles_css <<- DELIM
body {
    color: blue;
}
DELIM
