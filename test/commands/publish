#!/bin/bash

test_group "publish command"

thumbnail_warning="A thumbnail is required before creating a card with this design. This is used to represent the App in the mobile application and the Appstore experience."
source test/design_assets

domo:fs:tmp:cd
domo:auth:login

it "should include a warning when no thumbnail exists"
contains "$thumbnail_warning" "$(domo publish)"
ok


it "should not have a warning when a thumbnail is present"
touch thumbnail.png
not_contains "$thumbnail_warning" "$(domo publish --go)"
ok


it "should have an id in the manifest.json file"
manifest_content=$(cat manifest.json)
contains "id" "$(cat manifest.json)"
ok
msg design name: $(json_extract "name" "$manifest_content")
msg design id: $(json_extract "id" "$manifest_content")
