#!/bin/bash

design_name="autogenerated-$(date +%s)-$RANDOM"
design_version="1.0.0"

manifest_json=$(domo:fs:tmp:file manifest.json)
index_html=$(domo:fs:tmp:file index.html)
styles_css=$(domo:fs:tmp:file styles.css)

domo:log:comment "creating design assets"

cat > $manifest_json <<- DELIM
{
  "name": "$design_name",
  "version": "$design_version",
  "size": {
    "width": 1,
    "height": 1
  },
  "mapping": []
}
DELIM

cat > $index_html <<- DELIM
<html>
  <head>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <h1>$design_name</h1>
  </body>
</html>
DELIM

cat > $styles_css <<- DELIM
body {
    color: blue;
}
DELIM

domo:fs:tmp:cd
domo:auth:login

domo:log:comment "you should see a warning about the thumbnail"
domo publish
domo:runner:validate

domo:log:comment "you should *NOT* see a warning about the thumbnail"
touch thumbnail.png
domo publish
domo:runner:validate

domo:log:comment "publishing a third time"
domo publish
domo:runner:validate

domo:log:comment "should have an id"
cat manifest.json
cat manifest.json | grep '"id"' &> /dev/null
domo:runner:validate
