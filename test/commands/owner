#!/bin/bash

test_group "owner command"

one_owner_error="DA0049: DESIGN entities must have at least one owner. A new owner needs to be assigned before removing this one."
invalid_remove_error="Error removing owners"
invalid_add_error="Error adding owners"

source test/design_assets

domo:fs:tmp:cd
domo:auth:login

it "should publish a design first"
domo publish &> /dev/null
ok
manifest_content=$(cat manifest.json)
msg design name: $(json_extract "name" "$manifest_content")
msg design id: $(json_extract "id" "$manifest_content")

it "should include the user that published as an owner"
contains "$DOMO_USERNAME" "$(domo owner ls)"
ok

it "prevents the only owner from being removed"
contains "$one_owner_error" "$(domo owner rm $DOMO_USERNAME)"
ok

it "throws error when removing an invalid user"
contains "$invalid_remove_error" "$(domo owner rm $DOMO_USERNAME.invalid)"
ok

it "throws error when adding an invalid user"
contains "$invalid_add_error" "$(domo owner add $DOMO_USERNAME.invalid)"
ok

it "can add a new owner"
domo owner add $DOMO_USERNAME_2 &> /dev/null
ok

it "lists the new owner in the list of owners"
contains "$DOMO_USERNAME_2" "$(domo owner ls)"
ok

it "should be able to remove the new user"
domo owner rm $DOMO_USERNAME_2 &> /dev/null
ok

it "should not include that user anymore"
not_contains "$DOMO_USERNAME_2" "$(domo owner ls)"
ok

it "delete the published design"
manifest_content=$(cat manifest.json)
design_id=$(json_extract "id" "$manifest_content")
echo "y" | domo delete --design_id "$design_id" &> /dev/null
ok
