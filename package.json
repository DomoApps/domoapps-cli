{
  "name": "ryuu",
  "version": "4.0.1",
  "description": "Domo App Dev Studio CLI, The main tool used to create, edit, and publish app designs to Domo",
  "keywords": [
    "CLI",
    "Domo",
    "Ryuu",
    "App"
  ],
  "homepage": "https://developer.domo.com/docs/dev-studio/dev-studio-overview",
  "license": "SEE LICENSE IN LICENSE.doc",
  "bin": {
    "domo": "./bin/runner"
  },
  "scripts": {
    "changelog": "conventional-changelog -i CHANGELOG.md -s -r 0 --config ./changelog/changelog.js",
    "build": "tsc && npm run build:phoenix -s && npm run copyfiles ",
    "build:phoenix": "ncp \"./node_modules/@domoinc/domo-phoenix/build/global/domoPhoenix.js\" \"./templates/basic chart/domoPhoenix.js\" && ncp \"./node_modules/@domoinc/domo-phoenix/build/global/domoPhoenixWithMaps.js\" \"./templates/map chart/domoPhoenixWithMaps.js\" && ncp \"./node_modules/@domoinc/domo-phoenix/build/global/domoPhoenixWithMaps.js\" \"./templates/sugarforce/js/domoPhoenixWithMaps.js\"",
    "push": "git push && git push --tags",
    "preversion": "npm run build",
    "version": "npm run changelog && git add CHANGELOG.md templates/**/domoPhoenix*.js",
    "remove": "rimraf \"node_modules/ryuu-client/*\"",
    "copyfiles": "npm run copyjson && npm run copyreadme && npm run copydomodev && npm run copytemplates && npm run copyexamples && npm run copyrunner",
    "copytemplates": "cp -r \"server/domodev/\" \"dist/server/domodev\"  && cp -r \"templates/\" \"dist/templates\"",
    "copyexamples": "cp -r \"examples/\" \"dist/examples\"",
    "copyrunner": "cp \"bin/runner\" \"dist/bin/\"",
    "copyreadme": "cp  \"README.md\" \"dist/\"",
    "copyjson": "cp  \"package.json\" \"dist/\"",
    "copydomodev": "cp -r \"server/domodev/\" \"dist/server/domodev\"",
    "typescript": "npm run remove && npm run copy && tsc",
    "release": "npm run build && cd dist && npm publish && cd ..",
    "releaseBeta": "npm run build && cd dist && npm publish --tag beta && cd ..",
    "test": "TS_NODE_FILES=true NODE_ENV=test mocha -r ts-node/register -r mocha-clean '**/*.spec.ts' --exclude 'cypress/**/*' --exit",
    "test:browser": "./node_modules/.bin/cypress open",
    "test:it": "./node_modules/.bin/cypress run"
  },
  "dependencies": {
    "@domoinc/ryuu-proxy": "^4.0.5",
    "@types/configstore": "^4.0.0",
    "async": "^3.2.0",
    "bluebird": "^3.7.2",
    "browser-sync": "^2.26.12",
    "chalk": "^4.0.0",
    "cli-table": "^0.3.1",
    "commander": "^3.0.2",
    "configstore": "^5.0.1",
    "express": "^4.17.1",
    "extract-zip": "^2.0.0",
    "fs-extra": "^9.0.0",
    "glob": "^7.1.6",
    "inquirer": "^7.3.3",
    "lodash": "^4.17.19",
    "ncp": "^2.0.0",
    "open": "^7.1.0",
    "portfinder": "^1.0.28",
    "q": "^1.4.1",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "rimraf": "^3.0.0",
    "ryuu-client": "^4.0.5",
    "ryuu.js": "^3.0.6",
    "semver": "^7.3.2",
    "shelljs": "^0.8.4",
    "slug": "^3.3.4",
    "source-map-support": "^0.5.19",
    "validator": "^13.0.0"
  },
  "devDependencies": {
    "@domoinc/domo-phoenix": "^0.14.2",
    "@types/async": "^3.2.3",
    "@types/bluebird-global": "^3.5.12",
    "@types/chai": "^4.2.12",
    "@types/express": "^4.17.7",
    "@types/extract-zip": "^1.6.2",
    "@types/fs-extra": "^9.0.1",
    "@types/inquirer": "^7.3.0",
    "@types/lodash": "^4.14.159",
    "@types/mocha": "^8.0.2",
    "@types/node": "^14.0.27",
    "@types/q": "^1.5.4",
    "@types/request-promise": "^4.1.46",
    "@types/semver": "^7.3.1",
    "@types/shelljs": "^0.8.8",
    "@types/slug": "^0.9.1",
    "@types/validator": "^13.0.0",
    "@typescript-eslint/eslint-plugin": "^3.9.0",
    "@typescript-eslint/parser": "^3.9.0",
    "chai": "^4.2.0",
    "compare-func": "^2.0.0",
    "conventional-changelog-cli": "^2.0.34",
    "cypress": "^4.12.1",
    "eslint": "^7.6.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.4",
    "github-url-from-git": "^1.4.0",
    "mocha": "^8.1.1",
    "mocha-clean": "^1.0.0",
    "prettier": "^2.0.5",
    "ts-node": "^8.10.2",
    "typescript": "^3.9.7"
  },
  "pkg": {
    "scripts": [
      "package.json",
      "commands/*.js"
    ],
    "assets": [
      "templates/**/*",
      "./node_modules/open/xdg-open/**",
      "./node_modules/fsevents/fsevents.node",
      "server/domodev/**/*"
    ]
  }
}