{
  "name": "ryuu",
  "version": "3.1.0",
  "bin": {
    "domo": "./bin/runner"
  },
  "scripts": {
    "changelog": "conventional-changelog -i CHANGELOG.md -s -r 0 --config ./changelog/changelog.js",
    "build": "npm run build:phoenix -s",
    "build:phoenix": "ncp \"./node_modules/@domoinc/domo-phoenix/build/global/domoPhoenix.js\" \"./templates/basic chart/domoPhoenix.js\" && ncp \"./node_modules/@domoinc/domo-phoenix/build/global/domoPhoenixWithMaps.js\" \"./templates/map chart/domoPhoenixWithMaps.js\"",
    "push": "git push && git push --tags",
    "preversion": "npm run build",
    "version": "npm run changelog && git add CHANGELOG.md templates/**/domoPhoenix*.js"
  },
  "dependencies": {
    "async": "~1.3.0",
    "bluebird": "~2.3.2",
    "browser-sync": "^2.26.3",
    "chalk": "~0.5.1",
    "cli-table": "^0.3.1",
    "commander": "2.9.0",
    "extract-zip": "^1.0.3",
    "form-data": "~0.1.4",
    "fs-extra": "~0.30.0",
    "glob": "7.0.5",
    "inquirer": "0.6.0",
    "keytar": "^4.0.5",
    "koa": "^0.21.0",
    "koa-better-body": "^3.0.4",
    "koa-bodyparser": "2.0.1",
    "koa-mount": "^1.3.0",
    "koa-router": "^5.1.2",
    "koa-static": "^1.4.9",
    "lodash": "~2.4.1",
    "ncp": "^2.0.0",
    "portfinder": "^0.4.0",
    "proxy-addr": "1.1.2",
    "publish": "^0.6.0",
    "q": "^1.4.1",
    "raw-body": "^2.1.6",
    "request": "^2.88.0",
    "ryuu-client": "^3.0.1",
    "ryuu.js": "^2.6.2",
    "semver": "~4.1.0",
    "shelljs": "^0.5.1",
    "slug": "^0.9.1",
    "source-map-support": "^0.3.2",
    "superagent": "~0.18.1",
    "validator": "~3.35.0"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.2.0",
    "@domoinc/domo-phoenix": "^0.8.4",
    "compare-func": "^1.3.1",
    "conventional-changelog-cli": "1.2.0",
    "github-url-from-git": "^1.4.0"
  }
}
